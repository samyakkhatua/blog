---
import { SITE_CONFIG } from '../config';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="site-brand">
        {SITE_CONFIG.author.name}
        <span class="brand-suffix">/ blog</span>
      </a>

      <nav class="nav-links">
        <a href="/" class="nav-link">Writing</a>
        <a href="https://samyakkhatua.in" target="_blank" rel="noopener noreferrer" class="nav-link">Portfolio ↗</a>
        {SITE_CONFIG.author.social.github && (
          <a href={SITE_CONFIG.author.social.github} target="_blank" rel="noopener noreferrer" class="nav-link">GitHub ↗</a>
        )}
        {SITE_CONFIG.author.social.linkedin && (
          <a href={SITE_CONFIG.author.social.linkedin} target="_blank" rel="noopener noreferrer" class="nav-link">LinkedIn ↗</a>
        )}
      </nav>

      <div class="header-actions">
        <a href="https://samyakkhatua.in#contact" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 0.4rem 0.9rem; font-size: 0.75rem;">
          Get in touch
        </a>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
