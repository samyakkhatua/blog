---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../lib/posts';
import { SITE_CONFIG } from '../config';

const posts = await getAllPosts();
---

<Layout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <!-- Hero Section matching samyakkhatua.in -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-status">
        <span class="pulse-dot"></span>
        <span class="label-mono">Engineering Blog & Notes</span>
      </div>

      <h1 class="hero-title">
        {SITE_CONFIG.author.name} — Technical thoughts on <span class="text-signal-gradient">multi-tenant platforms</span>, <span class="text-signal-gradient">event-driven backends</span> & AI systems.
      </h1>

      <p class="hero-description">
        Senior full stack engineer writing honest observations on software architecture, production systems, and lessons learned along the way.
      </p>

      <div class="hero-actions">
        <a href="https://samyakkhatua.in" target="_blank" rel="noopener noreferrer" class="btn-primary">
          View Portfolio ↗
        </a>
        {SITE_CONFIG.author.social.github && (
          <a href={SITE_CONFIG.author.social.github} target="_blank" rel="noopener noreferrer" class="btn-outline">
            GitHub ↗
          </a>
        )}
        {SITE_CONFIG.author.social.linkedin && (
          <a href={SITE_CONFIG.author.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-outline">
            LinkedIn ↗
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Articles Section -->
  <div class="container">
    <div class="section-divider" style="margin-top: 3rem;">
      <span class="label-mono">01 / Articles & Notes</span>
      <div class="divider-line"></div>
      <span class="label-mono">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </div>

    {posts.length === 0 ? (
      <div style="text-align: center; padding: 4rem 1.5rem; border: 1px dashed var(--border-color); border-radius: var(--radius-lg); background-color: var(--bg-surface); margin-bottom: 4rem;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: auto; margin-right: auto; margin-bottom: 1rem; color: var(--text-subtle);">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        <h3 class="font-display" style="font-size: 1.125rem; font-weight: 600; color: var(--text-foreground); margin-bottom: 0.5rem;">
          No articles published yet
        </h3>
        <p style="font-size: 0.875rem; color: var(--text-muted); max-width: 24rem; margin-left: auto; margin-right: auto;">
          Add a <code class="font-mono">.md</code> file to your content repository (<code class="font-mono">{SITE_CONFIG.contentSource.githubUsername}/{SITE_CONFIG.contentSource.repository}</code>) to publish your first post!
        </p>
      </div>
    ) : (
      <div class="posts-grid">
        {posts.map((post) => (
          <article class="post-card">
            <div class="post-card-meta">
              <span>{post.frontmatter.date}</span>
              <span>•</span>
              <span>{post.readTime}</span>
              <span>•</span>
              <a
                href={post.rawUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="markdown-link"
                style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); text-decoration: none;"
                onClick={(e) => e.stopPropagation()}
              >
                View as Markdown ↗
              </a>
            </div>

            <a href={`/posts/${post.slug}`} style="text-decoration: none;">
              <h2 class="post-card-title">{post.frontmatter.title}</h2>
            </a>

            {post.frontmatter.summary && (
              <p class="post-card-summary">{post.frontmatter.summary}</p>
            )}

            <div class="post-card-footer">
              <div class="post-card-tags">
                {post.frontmatter.tags && post.frontmatter.tags.map((tag) => (
                  <span class="tag-badge">#{tag}</span>
                ))}
              </div>

              <a href={`/posts/${post.slug}`} class="read-link">
                Read article <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
