---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../lib/posts';
import { SITE_CONFIG } from '../config';

const posts = await getAllPosts();
---

<Layout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <div class="container-narrow">
    <!-- Hero / Author Bio Header -->
    <div style="margin-top: 3rem; margin-bottom: 2.5rem; text-align: center;">
      <div style="display: inline-block; position: relative; margin-bottom: 1rem;">
        <img
          src={SITE_CONFIG.author.avatar}
          alt={SITE_CONFIG.author.name}
          style="width: 5rem; height: 5rem; border-radius: 9999px; border: 3px solid var(--border-color); object-fit: cover;"
        />
      </div>
      <h1 style="font-size: 2.25rem; font-weight: 800; tracking-tight; margin-bottom: 0.5rem; color: var(--text-foreground);">
        {SITE_CONFIG.author.name}
      </h1>
      <p style="font-size: 1.125rem; color: var(--text-muted); max-width: 32rem; margin-left: auto; margin-right: auto; margin-bottom: 1.25rem;">
        {SITE_CONFIG.author.bio}
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem;">
        {SITE_CONFIG.author.social.github && (
          <a href={SITE_CONFIG.author.social.github} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )}
        {SITE_CONFIG.author.social.linkedin && (
          <a href={SITE_CONFIG.author.social.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        )}
      </div>
    </div>

    <div style="border-top: 1px solid var(--border-color); margin-bottom: 2rem;"></div>

    <!-- Articles Section -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-foreground);">
        Latest Articles
      </h2>
      <span style="font-size: 0.875rem; color: var(--text-muted);">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </span>
    </div>

    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-card-header">
            <span>{post.frontmatter.date}</span>
            <span class="dot-separator">•</span>
            <span>{post.readTime}</span>
            <span class="dot-separator">•</span>
            <a
              href={post.rawUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="markdown-link"
              onClick={(e) => e.stopPropagation()}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              View as Markdown
            </a>
          </div>

          <a href={`/posts/${post.slug}`} style="text-decoration: none; display: block;">
            <h3 class="post-card-title">{post.frontmatter.title}</h3>
          </a>

          {post.frontmatter.summary && (
            <p class="post-card-summary">{post.frontmatter.summary}</p>
          )}

          {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
            <div class="post-card-tags">
              {post.frontmatter.tags.map((tag) => (
                <span class="tag-badge">#{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
