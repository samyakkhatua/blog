---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
---

<Layout title={`Page Not Found | ${SITE_CONFIG.title}`}>
  <div class="container-narrow" style="padding-top: 6rem; padding-bottom: 6rem; text-align: center;">
    <h1 style="font-size: 6rem; font-weight: 800; color: var(--primary); line-height: 1; margin-bottom: 1rem;">
      404
    </h1>
    <h2 style="font-size: 2rem; font-weight: 700; color: var(--text-foreground); margin-bottom: 1rem;">
      Page Not Found
    </h2>
    <p style="font-size: 1.125rem; color: var(--text-muted); margin-bottom: 2rem; max-width: 24rem; margin-left: auto; margin-right: auto;">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <a
      href="/"
      style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: var(--radius-md); background-color: var(--primary); color: #ffffff; font-weight: 600; text-decoration: none; transition: opacity 0.2s ease;"
      onmouseover="this.style.opacity='0.9'"
      onmouseout="this.style.opacity='1'"
    >
      Return to Home
    </a>
  </div>
</Layout>
