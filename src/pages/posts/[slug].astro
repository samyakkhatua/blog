---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, type Post } from '../../lib/posts';
import { SITE_CONFIG } from '../../config';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { frontmatter, html, readTime, toc, rawUrl } = post;
const hasToc = toc && toc.length > 0;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.summary}
  image={frontmatter.coverImage}
  type="article"
  publishDate={frontmatter.date}
  updatedDate={frontmatter.updated}
  authorName={SITE_CONFIG.author.name}
>
  <div class="container">
    <!-- Header Section -->
    <header class="post-detail-header">
      <div class="label-mono" style="margin-bottom: 0.75rem;">
        01 / Article
      </div>
      
      <h1 class="post-detail-title">{frontmatter.title}</h1>
      
      <div class="post-card-meta" style="font-size: 0.8125rem;">
        <span>{frontmatter.date}</span>
        <span>•</span>
        <span>{readTime}</span>
        <span>•</span>
        <a
          href={rawUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="color: var(--signal); text-decoration: none; font-weight: 500;"
        >
          View as Markdown ↗
        </a>
      </div>
    </header>

    <!-- Cover Image -->
    {frontmatter.coverImage && (
      <div style="width: 100%; margin-bottom: 2.5rem; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-color);">
        <img
          src={frontmatter.coverImage}
          alt={frontmatter.title}
          style="width: 100%; height: auto; max-height: 28rem; object-fit: cover; display: block;"
        />
      </div>
    )}

    <!-- Author Card -->
    <div class="author-card">
      <img
        src={SITE_CONFIG.author.avatar}
        alt={SITE_CONFIG.author.name}
        class="author-avatar"
      />
      <div style="flex: 1;">
        <div class="author-name">{SITE_CONFIG.author.name}</div>
        <div class="author-bio">{SITE_CONFIG.author.bio}</div>
      </div>
      <a href="https://samyakkhatua.in" target="_blank" rel="noopener noreferrer" class="btn-outline" style="padding: 0.4rem 0.85rem; font-size: 0.75rem;">
        Portfolio ↗
      </a>
    </div>

    <!-- Article Content Layout (with Sidebar TOC) -->
    <div class={`post-layout-grid ${hasToc ? 'has-toc' : ''}`}>
      {hasToc && (
        <aside class="toc-sidebar">
          <div class="label-mono" style="margin-bottom: 0.75rem; font-size: 0.7rem;">On this page</div>
          <ul class="toc-list">
            {toc.map((item) => (
              <li style={{ paddingLeft: `${(item.level - 2) * 0.75}rem` }}>
                <a href={`#${item.id}`} class="toc-link">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <article class="prose" style="max-width: 48rem; margin-left: auto; margin-right: auto;">
        <Fragment set:html={html} />
      </article>
    </div>

    <!-- Back to Articles Button -->
    <div style="margin-top: 4rem; margin-bottom: 4rem; text-align: center;">
      <a href="/" class="btn-outline">
        ← Back to all articles
      </a>
    </div>
  </div>
</Layout>
