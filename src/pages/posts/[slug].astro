---
import Layout from '../../layouts/Layout.astro';
import { getAllPosts, type Post } from '../../lib/posts';
import { SITE_CONFIG } from '../../config';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { frontmatter, html, readTime, toc, rawUrl } = post;
const hasToc = toc && toc.length > 0;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.summary}
  image={frontmatter.coverImage}
>
  <div class="container">
    <!-- Header Section -->
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
      
      <div class="post-meta-bar">
        <span>{frontmatter.date}</span>
        <span class="dot-separator">•</span>
        <span>{readTime}</span>
        <span class="dot-separator">•</span>
        <a
          href={rawUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="markdown-link"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          View as Markdown
        </a>
      </div>
    </header>

    <!-- Cover Image -->
    {frontmatter.coverImage && (
      <div class="cover-image-container">
        <img
          src={frontmatter.coverImage}
          alt={frontmatter.title}
          class="cover-image"
        />
      </div>
    )}

    <!-- Author Card -->
    <div class="container-narrow" style="padding: 0;">
      <div class="author-card">
        <img
          src={SITE_CONFIG.author.avatar}
          alt={SITE_CONFIG.author.name}
          class="author-avatar"
        />
        <div style="flex: 1;">
          <div class="author-name">{SITE_CONFIG.author.name}</div>
          <div class="author-bio">{SITE_CONFIG.author.bio}</div>
        </div>
      </div>
    </div>

    <!-- Article Content Layout (with Sidebar TOC) -->
    <div class={`post-layout-grid ${hasToc ? 'has-toc' : ''}`}>
      {hasToc && (
        <aside class="toc-sidebar">
          <div class="toc-title">On this page</div>
          <ul class="toc-list">
            {toc.map((item) => (
              <li style={{ paddingLeft: `${(item.level - 2) * 0.75}rem` }}>
                <a href={`#${item.id}`} class="toc-link">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <article class="prose" style="max-width: 48rem; margin-left: auto; margin-right: auto;">
        <Fragment set:html={html} />
      </article>
    </div>

    <!-- Back to Articles Button -->
    <div style="margin-top: 4rem; margin-bottom: 4rem; text-align: center;">
      <a
        href="/"
        style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); background-color: var(--bg-card); color: var(--text-foreground); font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: all 0.2s ease;"
        onmouseover="this.style.borderColor='var(--primary)'; this.style.color='var(--primary)'"
        onmouseout="this.style.borderColor='var(--border-color)'; this.style.color='var(--text-foreground)'"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back to all articles
      </a>
    </div>
  </div>
</Layout>
